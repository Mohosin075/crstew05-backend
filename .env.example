NODE_ENV=development
PORT=5000
IP_ADDRESS=127.0.0.1
DATABASE_URL=mongodb://localhost:27017/crstew05

# Client URL
clientUrl=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Authentication & Security
BCRYPT_SALT_ROUNDS=12
JWT_SECRET=your_jwt_secret
JWT_EXPIRE_IN=1d
JWT_REFRESH_SECRET=your_refresh_secret
# Standard refresh: 30 days. "Remember me" long refresh: 90 days.
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_EXPIRE_LONG=90d
TEMP_JWT_SECRET=your_temp_secret
TEMP_JWT_EXPIRE_IN=5m

# Super Admin
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=password123

# Email Configuration (Resend)
EMAIL_FROM=no-reply@crstew05.com
RESEND_API_KEY=



# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# Cloudinary
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET=

# Social Login - Google
# GOOGLE_CLIENT_ID: Web/server client ID used to verify Flutter Google idTokens
# (comma-separate multiple audiences if needed). Secret/callback are web Passport only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Social Login - Facebook (REQUIRED for Facebook login)
# App ID + App Secret from https://developers.facebook.com/ → Settings → Basic
# Also put App ID + Client Token into Flutter:
#   android/.../res/values/strings.xml
#   ios/Runner/Info.plist
#   lib/core/config/social_auth_config.dart
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=

# Social Login - Instagram
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_CALLBACK_URL=

# Social Login - TikTok
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_CALLBACK_URL=

# Stripe Payment
STRIPE_API_SECRET=
WEBHOOK_SECRET=
SUCCESS_URL=
APPLICATION_FEE=
INSTANT_TRANSFER_FEE=

# Firebase
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=
FIREBASE_TOKEN_URI=
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=
FIREBASE_CLIENT_X509_CERT_URL=
FIREBASE_UNIVERSE_DOMAIN=

# OpenAI
OPENAI_API_KEY=

# Google Maps / Geocoding
SERVER_MAP_API_KEY=
